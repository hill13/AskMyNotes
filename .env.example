# Copy to .env and adjust. .env is gitignored.

# Port 5434 so this does not collide with a local Postgres on 5432 or 5433.
DATABASE_URL=postgresql://askmynotes:askmynotes@localhost:5434/askmynotes

# Ingestion limits
MAX_FILE_BYTES=10485760        # 10 MB, checked BEFORE extraction (server safety)
MAX_DOCUMENT_TOKENS=50000      # checked AFTER extraction (cost / quality)

# Chunking
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# Embeddings: "fake" (deterministic, offline, free) or "openai"
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1536
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
